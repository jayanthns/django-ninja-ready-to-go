# Django Related
APP_ENV=local
DJANGO_SETTINGS_MODULE=main.settings

# Database Related
DB_ENGINE=django.db.backends.postgresql  # Change as needed
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost  # Service name in docker-compose
DB_PORT=5432
DB_SCHEMA=public

# Connection Pooling (if using pgBouncer)
DB_CONN_MAX_AGE=10
DB_OPTIONS={}  # Example: {"sslmode": "require"} if SSL is needed

# Celery Related
RUN_CELERY_TOGETHER= # Example: `true` if you want to run the celery along with django otherwise `false`
CELERY_WORKERS= # Example: 4 if you want to run the celery with 4 workers
CELERY_WORKER_CONCURRENCY= # Example: 5 if you want to run the celery with 5 wokers concurrency
CELERY_PREFETCH_MULTIPLIER= # Example: 6 if you want to run the celery with 6 prefetch multiplier
CELERY_POOL= # Example: gevent
CELERY_QUEUE_NAME= # Example: `django_ninja_queue`

# Uvicorn Related
UVICORN_WORKERS= # Example: 4 if you want to run the uvicorn with 4 workers

# Supervisor Related
USE_SUPERVISOR= # Example: [true] if you want to run the celery and django together or django uvicorn with supervisor otherwise [false]
