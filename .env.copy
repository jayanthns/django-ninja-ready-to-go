# Django Related
APP_ENV=local
DJANGO_SETTINGS_MODULE=main.settings

# Database Related
DB_ENGINE=django.db.backends.postgresql  # Change as needed
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost  # Service name in docker-compose
DB_PORT=5432
DB_SCHEMA=public

# Connection Pooling (if using pgBouncer)
DB_CONN_MAX_AGE=10
DB_OPTIONS={}  # Example: {"sslmode": "require"} if SSL is needed

# Celery Related
RUN_CELERY_TOGETHER=true
CELERY_WORKERS=2
CELERY_WORKER_CONCURRENCY=2
CELERY_PREFETCH_MULTIPLIER=2
CELERY_POOL=gevent
CELERY_QUEUE_NAME="django_ninja_ready_to_go_queue"

# Dramatiq Related
RUN_DRAMATIQ_TOGETHER=true
DRAMATIQ_WORKERS=2
DRAMATIQ_WORKER_CONCURRENCY=2
DRAMATIQ_PREFETCH_MULTIPLIER=2
DRAMATIQ_POOL=gevent
DRAMATIQ_QUEUE_NAME="django_ninja_dramatiq_queue"

# Uvicorn Related
UVICORN_WORKERS= # Example: 4 if you want to run the uvicorn with 4 workers

# Supervisor Related
USE_SUPERVISOR= # Example: [true] if you want to run the celery and django together or django uvicorn with supervisor otherwise [false]

# Redis Related
REDIS_USERNAME=default
REDIS_PASSWORD=redis
REDIS_HOST_AND_PORT='localhost:6379'
USE_REDIS=1 # Example: [1] if you want to enable the Redis as cache otherwise it will be in-memory cache
